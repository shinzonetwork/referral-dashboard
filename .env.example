# PostgreSQL connection used by Prisma and the application.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/referral_dashboard?schema=public"

# NextAuth. Generate a local secret with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-random-local-secret"

# Server-to-server API credentials. Use different random values.
INGEST_API_TOKEN="replace-with-a-random-ingest-token"
ACCOUNTING_API_TOKEN="replace-with-a-random-accounting-token"

# URL produced when a referrer requests a shareable referral link.
# The final production domain/path must be confirmed with the frontend team.
NEXT_PUBLIC_REFERRAL_BASE_URL="http://localhost:3000/join"
NEXT_PUBLIC_REFERRAL_PARAM="ref"

# Development seed administrator. Do not use these sample values in production.
SEED_ADMIN_EMAIL="admin@shinzo.network"
SEED_ADMIN_PASSWORD="change-this-password"
SEED_ADMIN_NAME="Shinzo Admin"

# DIRECT_URL is not currently read by the application or Prisma config.
# Add it only if the chosen database provider/deployment workflow requires it.
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/referral_dashboard?schema=public"
